# --- Safety gates (required for live/destructive tests) ---
RESILIENCE_ENABLE_LIVE_TESTS=false
RESILIENCE_ACK_DISPOSABLE_TARGET=false
RESILIENCE_ENV_LABEL=disposable-vm
RESILIENCE_ALLOWED_ENV_LABELS=disposable-vm,sandbox,lab-vm

# --- Qumulo REST API (port 8000) ---
QUMULO_HOST=your-cluster.example.com
QUMULO_USER=admin
QUMULO_PASSWORD=changeme
QUMULO_REST_PORT=8000
QUMULO_CA_BUNDLE=
QUMULO_VERIFY_TLS=true

# --- Fixture namespace (must be allow-listed, never production) ---
RESILIENCE_FIXTURE_ROOT=/resilience-fixtures
RESILIENCE_S3_BUCKET=resilience-fixtures
RESILIENCE_RUN_ID=

# --- S3-compatible endpoint (port 9000) ---
QUMULO_S3_ENDPOINT=https://your-cluster.example.com:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- NFS (Linux container profile) ---
QUMULO_NFS_EXPORT=your-cluster.example.com:/resilience-fixtures
RESILIENCE_NFS_MOUNT=/mnt/qumulo-nfs

# --- SMB (Linux container profile) ---
QUMULO_SMB_SERVER=your-cluster.example.com
QUMULO_SMB_SHARE=resilience-fixtures
QUMULO_SMB_USER=admin
QUMULO_SMB_PASSWORD=changeme
QUMULO_SMB_DOMAIN=
RESILIENCE_SMB_MOUNT=/mnt/qumulo-smb

# --- Evidence output ---
RESILIENCE_EVIDENCE_DIR=evidence
